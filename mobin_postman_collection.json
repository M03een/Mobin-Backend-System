{
	"info": {
		"_postman_id": "c1f7b8ab-5322-4416-8367-1725ea4b553e",
		"name": "Mobin Backend API",
		"description": "Postman collection to test the Mobin Backend System API endpoints (Laravel 12). Includes pre-configured example request bodies and authorization placeholders.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": "{{base_url}}/register",
						"description": "Registers a new user account. Returns user details and an API authentication token."
					},
					"response": []
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": "{{base_url}}/login",
						"description": "Authenticates user credentials. Returns user details and an API authentication token."
					},
					"response": []
				},
				{
					"name": "Get Authenticated User (Me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{base_url}}/me",
						"description": "Retrieves the profile of the currently authenticated user."
					},
					"response": []
				},
				{
					"name": "Logout User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{base_url}}/logout",
						"description": "Revokes the current bearer token to log out the user."
					},
					"response": []
				}
			]
		},
		{
			"name": "Password Reset",
			"item": [
				{
					"name": "Forgot Password (OTP Request)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\"\n}"
						},
						"url": "{{base_url}}/password/forget",
						"description": "Sends a password-reset OTP code to the requested email. In local development with the default mail config, the OTP is written to backend log files under storage/logs/laravel.log."
					},
					"response": []
				},
				{
					"name": "Reset Password with OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"otp\": \"123456\",\n    \"password\": \"newpassword123\"\n}"
						},
						"url": "{{base_url}}/password/reset",
						"description": "Resets the user's password using the OTP code received."
					},
					"response": []
				}
			]
		},
		{
			"name": "Points",
			"item": [
				{
					"name": "Log Activity Points",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"zikr\",\n    \"amount\": 10\n}"
						},
						"url": "{{base_url}}/points",
						"description": "Records points for user activities. Valid types are: 'zikr' or 'tasbeh'. Valid amounts are between 1 and 100."
					},
					"response": []
				}
			]
		},
		{
			"name": "Leaderboards",
			"item": [
				{
					"name": "Get All Time Leaderboard",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{base_url}}/points/all",
						"description": "Fetches the top-10 all-time ranking users by points."
					},
					"response": []
				},
				{
					"name": "Get Daily Leaderboard",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{base_url}}/points/day",
						"description": "Fetches the top-10 daily ranking users by points."
					},
					"response": []
				},
				{
					"name": "Get Weekly Leaderboard",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{base_url}}/points/week",
						"description": "Fetches the top-10 weekly ranking users by points."
					},
					"response": []
				},
				{
					"name": "Get Monthly Leaderboard",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{base_url}}/points/month",
						"description": "Fetches the top-10 monthly ranking users by points."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "INSERT_TOKEN_HERE",
			"type": "string"
		}
	]
}
